# Synedrios Configuration
# Copy this file to .env and fill in the values.

# --- Required ---

# Slack Bot Token (xoxb-...)
# Create at https://api.slack.com/apps → OAuth & Permissions
SLACK_BOT_TOKEN=xoxb-your-bot-token

# Slack App Token (xapp-...) for Socket Mode
# Create at https://api.slack.com/apps → Basic Information → App-Level Tokens
SLACK_APP_TOKEN=xapp-your-app-token

# Anthropic API Key
ANTHROPIC_API_KEY=sk-ant-your-key

# Anthropic Console workspace id (wrkspc_...) — REQUIRED only if your key is
# identity-linked (the API answers 400 "anthropic-workspace-id is required").
# Workspace-scoped keys can leave this unset. Find it at
# https://console.anthropic.com/settings/workspaces
# ANTHROPIC_WORKSPACE_ID=wrkspc_your-workspace-id

# --- Optional ---

# LLM provider: anthropic | openai | ollama | vllm | lmstudio
LLM_PROVIDER=anthropic

# LLM model name (default: claude-sonnet-5)
LLM_MODEL=claude-sonnet-5

# LLM API base URL (override for VPC/internal endpoints)
# LLM_BASE_URL=https://api.anthropic.com

# AI participant display name
PARTICIPANT_NAME=Synedrios

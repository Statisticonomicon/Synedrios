# Environment
.env
*.env
!.env.example

# Data and databases
# `/data` (no trailing slash) also matches the symlink used to point the data
# directory at a fast disk — a trailing-slash pattern only matches directories,
# and committing the symlink would embed a machine-specific absolute path.
/data
data/
*.db
*.db-wal
*.db-shm

# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/
venv/
.venv/

# OS
.DS_Store
Thumbs.db

# IDE / local tooling
.idea/
.vscode/
*.swp
.claude/settings.local.json


# ── Appended 2026-08-29: defensive baseline (existing rules above left untouched) ──
.env.*
!.env.template
!.env.sample
# Re-state the exception from the block above: later patterns win, and
# `.env.*` here was silently re-ignoring the documented example file.
!.env.example
/env
/env.local
/env.production
